{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Top-down pose gestalt probe v1",
  "type": "object",
  "required": [
    "schema_version",
    "posture",
    "posture_basis",
    "posture_confidence",
    "body_configuration",
    "support_configuration",
    "semantic_pose_summary",
    "evidence",
    "counterevidence"
  ],
  "properties": {
    "schema_version": {"const": "pose-gestalt-1.0"},
    "posture": {
      "enum": ["standing", "seated", "squatting", "crouching", "kneeling", "lying", "reclining", "unknown"]
    },
    "posture_basis": {"enum": ["geometric", "contextual", "mixed", "unknown"]},
    "posture_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "body_configuration": {"type": ["string", "null"]},
    "support_configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["body_part", "relation", "target", "evidence_status", "confidence"],
        "properties": {
          "body_part": {"type": "string"},
          "relation": {"enum": ["supported_by", "resting_on", "leaning_on", "braced_on", "unknown"]},
          "target": {"type": "string"},
          "evidence_status": {"enum": ["observed", "contextual", "inferred", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "semantic_pose_summary": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
