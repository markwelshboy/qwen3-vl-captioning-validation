{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic V3 Analyze from immutable Extract",
  "type": "object",
  "required": [
    "schema_version",
    "posture",
    "actions",
    "interactions",
    "ownership_assessments",
    "support_context",
    "physical_summary",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "semantic-analyze-3.0"},
    "posture": {
      "type": "object",
      "required": ["value", "confidence", "assessment", "evidence", "limitations"],
      "properties": {
        "value": {"enum": ["seated", "standing", "reclining", "lying", "crouching", "kneeling", "walking", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "assessment": {"enum": ["supported", "plausible", "weak", "contradicted", "unknown"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "confidence", "evidence_status", "evidence", "limitations"],
        "properties": {
          "value": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_status": {"enum": ["observed", "contextual", "inferred", "unknown"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "actor_part",
          "actor_ownership",
          "target_ref",
          "target_text",
          "interpretation",
          "evidence_status",
          "confidence",
          "evidence",
          "limitations"
        ],
        "properties": {
          "type": {"enum": ["holding", "contact", "support", "reaching", "crossing", "gesture", "using", "unknown"]},
          "actor_part": {"type": ["string", "null"]},
          "actor_ownership": {"enum": ["target", "other", "unknown"]},
          "target_ref": {"type": ["string", "null"]},
          "target_text": {"type": ["string", "null"]},
          "interpretation": {"type": ["string", "null"]},
          "evidence_status": {"enum": ["observed", "contextual", "inferred", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "ownership_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part", "ownership", "confidence", "evidence", "limitations"],
        "properties": {
          "part": {"type": "string"},
          "ownership": {"enum": ["target", "other", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "support_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_relation",
          "target_ref",
          "target_description",
          "target_status",
          "confidence",
          "evidence",
          "limitations"
        ],
        "properties": {
          "subject_relation": {"enum": ["lying_on", "reclining_on", "seated_on", "standing_on", "leaning_against", "resting_on", "braced_on", "unknown"]},
          "target_ref": {"type": ["string", "null"]},
          "target_description": {"type": ["string", "null"]},
          "target_status": {"enum": ["grounded", "unresolved", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "physical_summary": {"type": ["string", "null"]},
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
